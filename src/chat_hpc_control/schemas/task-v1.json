{
  "type": "object",
  "properties": {
    "schema": {
      "const": "chat-hpc-control/task/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "engine_options": {
      "type": "object"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "git"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "repository",
            "ref",
            "files"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bundle"
            },
            "bundle_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "bundle_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "memory_mib": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "walltime_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cpus",
        "memory_mib",
        "walltime_seconds"
      ],
      "additionalProperties": false
    },
    "expected_results": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "energy-gradient/v1"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "record_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "quantities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "energy",
                        "gradient"
                      ]
                    },
                    "contains": {
                      "const": "energy"
                    }
                  },
                  "atom_symbols": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][a-z]?$"
                    }
                  },
                  "geometry_file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "geometry_unit": {
                    "enum": [
                      "angstrom",
                      "bohr"
                    ]
                  },
                  "charge": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991
                  },
                  "multiplicity": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "minimum": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "record_id",
                  "quantities",
                  "atom_symbols",
                  "geometry_file",
                  "geometry_unit",
                  "charge",
                  "multiplicity",
                  "method",
                  "basis",
                  "state_id"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "contract",
            "records"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "task_id",
    "engine_id",
    "engine_options",
    "source",
    "entrypoint",
    "resources",
    "expected_results"
  ],
  "additionalProperties": false,
  "title": "chat-hpc-control task v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
